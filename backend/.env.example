# Application
APP_NAME=TASMAC Bottle Return API
APP_ENV=development
DEBUG=True

# PostgreSQL connection
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tasmac_bottle_return

# Auth — generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
